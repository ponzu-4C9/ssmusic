# ------------------------------------------------------------
# 環境変数テンプレート
# このファイルを .env にコピーして値を編集してください:
#   cp .env.example .env
#
# .env は .gitignore 済み（コミットされない）。
# 本番サーバーでは git pull 後に必ず .env を用意すること。
# ------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=ssmusic
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=ssmusic
# host 部分の "db" は docker-compose のサービス名と一致させる
DATABASE_URL=postgres://ssmusic:change_me_please@db:5432/ssmusic

# --- アプリ ---
# ログイン用の共有パスワード（必ず変更すること）
APP_PASSWORD=change_me_login_password

# セッション Cookie の署名鍵。次のコマンドで生成して貼り付ける:
#   openssl rand -base64 32
SESSION_SECRET=generate_a_random_secret_here

# 信頼できるリバースプロキシ(Caddy等)の背後に置くときだけ "1" にする。
# 直接公開時は 0 のまま（x-forwarded-for 偽装によるレート制限回避を防ぐ）。
TRUST_PROXY=0

# MP3 保存先（docker compose 利用時は /app/media に上書きされる）
MEDIA_DIR=./media
