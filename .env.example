# ------------------------------------------------------------
# 環境変数テンプレート
# このファイルを .env にコピーして値を編集してください:
#   cp .env.example .env
#
# .env は .gitignore 済み（コミットされない）。
# 本番サーバーでは git pull 後に必ず .env を用意すること。
# ------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_USER=ssmusic
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=ssmusic
# host 部分の "db" は docker-compose のサービス名と一致させる
DATABASE_URL=postgres://ssmusic:change_me_please@db:5432/ssmusic

# --- アプリ ---
# ログイン用の共有パスワード（必ず変更すること）
APP_PASSWORD=change_me_login_password

# セッション Cookie の署名鍵。次のコマンドで生成して貼り付ける:
#   openssl rand -base64 32
SESSION_SECRET=generate_a_random_secret_here

# 信頼できるリバースプロキシ(Caddy等)の背後に置くときだけ "1" にする。
# 直接公開時は 0 のまま（x-forwarded-for 偽装によるレート制限回避を防ぐ）。
# ※ Caddy(本番)を使うなら 1 にする。
TRUST_PROXY=0

# 本番(Caddy)で使う公開ドメイン。docker-compose.caddy.yml と Caddyfile が参照。
DOMAIN=music.shirai-dev.com

# 家庭内 split DNS（docker-compose.dns.yml）を使う場合のみ: サーバーのLAN IP。
#   確認: ip route get 1.1.1.1 | grep -oP 'src \K\S+'   （172.x の Docker IP は不可）
# LAN_IP=192.168.3.x

# 【Caddy を使う本番サーバーのみ】次の行を有効化すると、以後 `docker compose ...`
# を打つだけで Caddy 込み（両方の compose ファイル）になり、毎回 -f を付けずに済む。
# ※ ローカル開発(WSL)では有効化しないこと（dev は docker-compose.dev.yml を使うため）。
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml

# MP3 保存先（docker compose 利用時は /app/media に上書きされる）
MEDIA_DIR=./media
